# TMDB API Read Access Token (v4 auth, the long "eyJ..." JWT).
# Get one at https://www.themoviedb.org/settings/api — it is free.
#
# Without this, ReelDex falls back to the bundled 91-title demo catalogue and
# says so in the UI. With it, TMDB becomes the primary catalogue.
#
# In this prototype the token reaches the browser. The provider layer is the
# only place that talks to TMDB, so moving these calls behind a proxy later
# does not touch any screen.
VITE_TMDB_READ_ACCESS_TOKEN=

# Used only by scripts/fetch-posters.mjs (build-time poster baking for the
# local demo catalogue). Not required to run the app.
TMDB_TOKEN=
